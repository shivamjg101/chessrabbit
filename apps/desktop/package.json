{
  "name": "chessrabbit-desktop",
  "version": "0.1.4",
  "description": "Free, open-source chess analysis and training on your computer",
  "author": "shivamjg101",
  "license": "GPL-3.0",
  "main": "main.cjs",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis --x64 --publish never"
  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.chessrabbit.desktop",
    "productName": "ChessRabbit",
    "directories": { "output": "../../dist/windows" },
    "files": ["main.cjs", "backup.cjs", "smoke.cjs", "loading.html", "app-lock.cjs", "app-lock.html", "app-lock-ui.js", "preload.cjs", "package.json"],
    "extraResources": [
      { "from": "../../dist/desktop-backend/ChessRabbitBackend", "to": "backend" },
      { "from": "../../dist/desktop-assets", "to": "runtime" },
      { "from": "../web/out", "to": "web" },
      { "from": "../../db/migrations", "to": "migrations" },
      { "from": "assets/starter-puzzles.csv.gz", "to": "data/starter-puzzles.csv.gz" },
      { "from": "../../LICENSE", "to": "licenses/LICENSE" },
      { "from": "../../THIRD_PARTY_NOTICES.md", "to": "licenses/THIRD_PARTY_NOTICES.md" },
      { "from": "../../PRIVACY.md", "to": "licenses/PRIVACY.md" },
      { "from": "../../SECURITY.md", "to": "licenses/SECURITY.md" },
      { "from": "../../LEGAL.md", "to": "licenses/LEGAL.md" },
      { "from": "../../CONTRIBUTING.md", "to": "licenses/CONTRIBUTING.md" },
      { "from": "../web/src/app/fonts", "to": "licenses/fonts", "filter": ["*.txt", "*.md"] }
    ],
    "electronLanguages": ["en-US"],
    "win": { "target": "nsis", "icon": "icon.ico", "requestedExecutionLevel": "asInvoker" },
    "nsis": {
      "artifactName": "ChessRabbit-Setup.exe",
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false,
      "license": "../../LICENSE",
      "runAfterFinish": true
    }
  }
}
